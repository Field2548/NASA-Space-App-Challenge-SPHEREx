# datatype:
# - name: access_url
#   datatype: string
#   description: URI for the physical artifact
#   meta: !!omap
#   - {ucd: meta.ref.url}
#   - {utype: 'obscore:access.reference'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: t_min
#   unit: d
#   datatype: float64
#   format: '{:.6f}'
#   description: Lower bound on time axis (Modified Julian Day)
#   meta: !!omap
#   - {ucd: time.start;obs.exposure}
#   - {precision: F6}
#   - {utype: 'obscore:char.timeaxis.coverage.bounds.limits.starttime'}
# - name: s_region
#   unit: deg
#   datatype: string
#   description: AstroCoordArea Region covered in STC
#   meta: !!omap
#   - {ucd: pos.outline;obs.field}
#   - {utype: 'obscore:char.spatialaxis.coverage.support.area'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: obs_id
#   datatype: string
#   description: Internal ID given by the ObsTAP service
#   meta: !!omap
#   - {ucd: meta.id}
#   - {utype: 'obscore:dataid.observationid'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: energy_bandpassname
#   datatype: string
#   description: Collection-specific name for energy band (e.g. filter name)
#   meta: !!omap
#   - {utype: 'caom2:Energy.bandpassName'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: obs_collection
#   datatype: string
#   description: Data collection this observation belongs to
#   meta: !!omap
#   - {ucd: meta.id}
#   - {utype: 'obscore:dataid.collection'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# schema: astropy-2.0
